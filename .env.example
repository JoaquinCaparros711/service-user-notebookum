# ─── Flask ───────────────────────────────────────────────────────────────────
FLASK_ENV=production
# ⚠ CAMBIAR: clave secreta para firmar los JWT
SECRET_KEY=changeme-use-a-long-random-string

# ─── URLs internas (no cambiar si usás la red notebookum-network) ─────────────
PERSISTENCE_URL=http://persistence-java.universidad.localhost:8080
REDIS_URL=redis://redis:6379/0

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_DAYS=7
